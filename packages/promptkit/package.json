{
  "name": "@nk33-dev/dsh-promptkit",
  "version": "0.1.2",
  "description": "Turn rough ideas into prompts that work in DeepSeek Harness, with guided questions, project context, and reusable prompts.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nk33-dev/dsh-promptkit.git"
  },
  "engines": {
    "node": ">=24",
    "dsh": "0.2.1-rc.2"
  },
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./remote": {
      "types": "./lib/types/shared/remote.d.ts",
      "default": "./lib/remote.js"
    },
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "lib/index.js",
    "lib/remote.js",
    "lib/client.js",
    "lib/types/**/*.d.ts",
    "rules/*.md",
    "cordis.patch.yml",
    "locale/*.json",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-api-gateway"
      ]
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.host.json --emitDeclarationOnly && tsc -p tsconfig.client.json --emitDeclarationOnly && tsdown --config tsdown.host.config.ts && tsdown --config tsdown.client.config.ts && node ../../scripts/verify-client.mjs"
  },
  "dependencies": {
    "lucide-react": "1.58.0",
    "zod": "4.4.3"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5",
    "@deepseek-ai/dsh-credentials": "0.2.1-rc.2",
    "@deepseek-ai/dsh-llm": "0.2.1-rc.2",
    "@deepseek-ai/dsh-storage-domain": "0.2.1-rc.2",
    "@deepseek-ai/dsh-typert-protocol": "0.2.1-rc.2"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "~4.0.5",
    "@deepseek-ai/dsh-api-gateway": "0.2.1-rc.2",
    "@deepseek-ai/dsh-api-session-controller": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-conversation": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.1-rc.2",
    "@deepseek-ai/dsh-credentials": "0.2.1-rc.2",
    "@deepseek-ai/dsh-llm": "0.2.1-rc.2",
    "@deepseek-ai/dsh-storage": "0.2.1-rc.2",
    "@deepseek-ai/dsh-storage-domain": "0.2.1-rc.2",
    "@deepseek-ai/dsh-storage-json": "0.2.1-rc.2",
    "@deepseek-ai/dsh-typert-protocol": "0.2.1-rc.2",
    "@deepseek-ai/dsh-typert-registry": "0.2.1-rc.2",
    "prettier": "3.6.2"
  }
}
